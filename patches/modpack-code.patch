+test('research selection capacity and per-type uniqueness also constrain client Mayer allowance', () => {
+  const full = spec(), p = full.players[0];
+  p.units.push(device({ uid: 3, tokenId: ENERGY, row: 12, col: 5, researchKey: 'energy' }));
