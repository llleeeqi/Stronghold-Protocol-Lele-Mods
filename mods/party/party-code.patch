+.damage-board__empty > span { font-size: max(.12rem, 11px); }
+.damage-board__rules { flex: none; margin-top: .1rem; padding-top: .08rem; border-top: 1px solid var(--line); color: var(--text-lo); font-size: max(.11rem, 10px); line-height: 1.6; }
+.damage-board__rules > summary { width: max-content; cursor: pointer; }
+.damage-board__rules > p { margin: .06rem 0 0; }
+@media (max-width: 900px) {
+  .damage-board__toggle { width: max(.56rem, 32px); padding: 0; justify-content: center; }
+  /* Keep the report clear of avatars and within the viewport, including short landscape screens. */
+  .damage-board__panel { position: fixed; left: max(100px, 1.75rem); right: 16px; bottom: calc(.24rem + max(.56rem, 32px) + .12rem); width: auto; max-width: 320px; max-height: calc(100dvh - .24rem - max(.56rem, 32px) - .12rem - 16px); padding: 12px; }
+}
+@media (max-width: 767px) {
+  /* Keep the existing two-row corner on narrow screens; a fourth control must not create a third row. */
+  .gm:not(.is-collapsed) .gm__corner { --corner-control: max(.56rem, 32px); display: grid; grid-template-columns: repeat(4, var(--corner-control)); width: max-content; }
+  .gm:not(.is-collapsed) .gm__corner > .gm__gear { grid-row: 1; width: var(--corner-control); height: var(--corner-control); }
+  .gm:not(.is-collapsed) .gm__corner > .ewheel { grid-row: 2; grid-column: 1 / 4; }
+  .gm:not(.is-collapsed) .gm__corner > .damage-board { grid-row: 2; grid-column: 4; }
+  .gm:not(.is-collapsed) .gm__corner .damage-board__toggle { width: var(--corner-control); height: var(--corner-control); }
+}
+@media (max-width: 767px) and (pointer: coarse), (max-width: 767px) and (any-pointer: coarse) {
+  .gm:not(.is-collapsed) .gm__corner { --corner-control: max(.56rem, 34px); }
+}
+@media (prefers-reduced-motion: reduce) { .damage-board__bar > i { transition: none; } }
+@media (forced-colors: active) {
+  .damage-board__bar { border: 1px solid CanvasText; background: Canvas; }
+  .damage-board__bar > i { forced-color-adjust: none; background: repeating-linear-gradient(135deg, CanvasText 0 2px, Canvas 2px 4px); }
+}
