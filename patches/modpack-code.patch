+          for (const e of enemies(true)) b.dealDamage(u, e, { amount: u.s.atk * t1.atk_scale, type: 'true', tags: ['talent', 'makotoAllOut'] });
+        }
+      }, { owner: u });
+      b.on('fatal', c => {
+        if (c.unit !== u || c.prevented) return;
