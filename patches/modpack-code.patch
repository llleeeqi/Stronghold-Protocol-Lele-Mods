+    h.b.removeBuff(t, 'test:healFree');
+    h.b.addBuff(t, { key: 'absoluteNoHeal', flags: { noHeal: true } });
+    assert.equal(h.b.heal(medical, t, 100), 0, 'medical exception never bypasses unrelated noHeal');
+    done(h);
+  }
