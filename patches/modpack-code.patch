+    rel: `relics/${id}.png`, kind: 'png',
+    urls: [`https://torappu.prts.wiki/assets/roguelike_topic_itempic/${file}`],
+  }] }]), ...Object.keys(CUSTOM_RELIC_ICON_FILES).map((id) => [id, { alts: [{
