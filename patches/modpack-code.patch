+    [3, [0, 0, 100, 0, 0]], [5, [0, 0, 100, 0, 0]],
+    [6, [0, 0, 65, 35, 0]], [8, [0, 0, 65, 35, 0]],
+    [9, [0, 0, 60, 30, 10]], [11, [0, 0, 60, 30, 10]],
+    [12, [0, 0, 55, 30, 15]], [15, [0, 0, 55, 30, 15]],
