+import {html,alertDialog} from './components.js';
+export const MOD_OPTIONS = Object.freeze([
+ ['rounds','额外 4 回合','多四回合，Boss 在最后','常规 14 回合变为 18，短单人 9 回合变为 13。Boss 移至最后一关，延长模式不再追加隐藏关。关闭时保持原版回合规则。'],
+ ['rhine','莱茵生命','科研装置、干员与装备','加入莱茵科研装置、梅尔、多萝西、赫默、溯光星源等扩展内容，调整莱茵盟约和专属装备。梅尔通过有效装置工作产层，伊芙利特继承最高单台装置攻击。新增五阶干员谬因，仅开放二技能自动战斗适配：直线周期法伤，中继器增攻和友军法抗穿透。友军改变波束方向仍作简化，复杂三技能暂未开放。'],
+ ['relics','收藏品玩法','战后选择，本局持续增益','无漏怪作战后藏品三选一，共 39 件，本局持续生效、不占装备槽。连续三个作战回合本人漏怪可获逆风补给与下回合护盾。新一局重新收集。'],
+ ['operators','新干员包','结城理等四名干员','加入结城理、娜仁图亚、予愿安洁莉娜和丰川祥子，包含技能、特质与模组。可与额外干员包同时开启，丰川祥子沿用本包实现，只会进卡池一次。'],
+ ['damage','伤害统计','干员实际输出排行','查看本轮与上一轮实际扣血排行，召唤物伤害归属干员。仅用于本局查看，不写长期战绩；关闭时不生成伤害面板。'],
+ ['lucky','恭喜发财','每人随机五阶开局','确认本局信息时，每名玩家和 AI 各获得一名不同的随机五阶干员，可正常部署、合成和出售。抽取使用本局可用公共卡池，照常消耗份数，可与任意难度组合。'],
+ ['recruits','额外干员包','望、陈、凯尔希与维什戴尔','加入望、赤刃明霄陈、凯尔希·思衡托、维什戴尔。当前移植范围：望、陈、维什戴尔三技能，凯尔希二技能，技能自动释放；战斗中点望可放置棋子。丰川祥子由原新干员包提供，本包不重复添加；两个包可同时开启。'],
+ ['targeted','定向甄选','奖励向已激活盟约靠拢','晋升奖励三选一的前两个位置优先匹配人数最多、层数最多的合适盟约，第三个保持随机；无符合候选时退回随机。装备招募对当前主要盟约的转职装备给予两倍抽取权重，仍遵守卡池和招募等级。'],
+]);
