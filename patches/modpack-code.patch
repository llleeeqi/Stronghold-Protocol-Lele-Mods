+test('supplemental state never reads a warning from a future snapshot',()=>{
+  const b=new SnapshotBuffer();const first={t:5,units:[],kazdel:[]},future={t:8,units:[],kazdel:[state()]};
+  b.push(first,0);b.push(future,3);
