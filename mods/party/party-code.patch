+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {Lobby} from '../server/lobby.js';
+import {SessionRegistry} from '../server/net.js';
+import {getDataProfile} from '../server/data.js';
+import {validateC2S} from '../shared/protocol.js';
+import {VirtualScheduler} from '../server/match/scheduler.js';
+import {makeMatch} from './match/harness.js';
+const quiet={info(){},warn(){},error(){}};
+const custom='chess_char_5_makoto_a';
+function setup(){const registry=new SessionRegistry();const lobby=new Lobby({registry,log:quiet,getDataProfile:(r,o)=>getDataProfile(r,{operatorsEnabled:o,log:quiet}),matchOpts:{scheduler:new VirtualScheduler(),combat:'server'}});const player=name=>{const s=registry.create(name);s.connected=true;s.messages=[];s.ws={readyState:1,bufferedAmount:0,send:v=>s.messages.push(JSON.parse(v))};return s;};const send=(s,m)=>{assert.equal(validateC2S(m),null);return lobby.onMessage(s,m);};return {lobby,player,send};}
+test('all 32 independent combinations capture the correct cards and 14/18 rounds',()=>{for(let flags=0;flags<32;flags++){const h=setup(),host=h.player('host');try{const options={rhineEnabled:!!(flags&1),doubleRounds:!!(flags&2),relicsEnabled:!!(flags&4),operatorsEnabled:!!(flags&8),damageEnabled:!!(flags&16)};assert.ok(h.send(host,{t:'room.create',mode:'coop',difficulty:'NORMAL',...options}).ok);const room=h.lobby.roomOf(host);assert.equal(!!room.data.chess[custom],options.operatorsEnabled);assert.ok(h.send(host,{t:'room.start'}).ok);const m=room.match;for(const k of ['rhineEnabled','relicsEnabled','operatorsEnabled','damageEnabled'])assert.equal(m[k],options[k]);assert.equal(m.gd.bossRound,options.doubleRounds?18:14);assert.equal(!!m.damageBoard,options.damageEnabled);assert.equal(m.publicView().dataProfile,(options.rhineEnabled?'rhine':'vanilla')+(options.operatorsEnabled?'-extra':''));assert.throws(()=>m.operatorsEnabled=false,TypeError);}finally{h.lobby.shutdown();}}});
+test('waiting-room changes synchronize, clear readiness, sanitize loadouts, and lock on start',()=>{const h=setup(),host=h.player('host'),friend=h.player('friend'),other=h.player('other');try{h.send(host,{t:'room.create',mode:'coop',difficulty:'NORMAL'});const room=h.lobby.roomOf(host);h.send(friend,{t:'room.join',code:room.code});h.send(other,{t:'room.create',mode:'solo',difficulty:'NORMAL'});const independent=h.lobby.roomOf(other);for(const mod of ['operators','relics','damage']){assert.equal(h.send(friend,{t:'room.setMod',mod,enabled:true}).error,'NOT_HOST');h.send(friend,{t:'room.ready',ready:true});assert.ok(h.send(host,{t:'room.setMod',mod,enabled:true}).ok);assert.equal(room.seats.find(s=>s?.playerId===friend.playerId).ready,false);assert.equal(independent[mod+'Enabled']===true,false);assert.equal(friend.messages.at(-1)[mod+'Enabled'],true);}assert.ok(h.send(friend,{t:'room.loadout',entries:{[custom]:{skill:2}}}).ok);h.send(host,{t:'room.setMod',mod:'operators',enabled:false});assert.equal(Object.hasOwn(friend.loadout||{},custom),false);h.send(friend,{t:'room.ready',ready:true});h.send(host,{t:'room.start'});for(const mod of ['operators','relics','damage'])assert.equal(h.send(host,{t:'room.setMod',mod,enabled:false}).error,'ROOM_STARTED');}finally{h.lobby.shutdown();}});
+test('default-off mods award no relics and send no damage frames',()=>{const h=makeMatch({mode:'solo',combat:'server'}).start();h.toPrep(2);assert.ok([...h.m.players.values()].every(p=>!p.relicOffer&&!p.relics?.length));assert.equal(h.m.damageBoard,null);h.m.dispose();});
