+ defs:{enemies:{e:enemyRec({key:'e',hp:1e8,atk:0,def:1000,res:0,speed:0})}},enemies:enemy?[{key:'e',pos:[10,6]}]:[],captureNoisy:true,autoFinish:false,timeLimit:100});h.step();return {h,u:h.unit(cid),e:h.enemies()[0]};}
