 .draft__main { position: relative; z-index: 1; flex: 1; min-height: 0; display: grid; grid-template-columns: 3.9rem 1fr 5rem; gap: .3rem; padding: .3rem .42rem .36rem; }
 
-.draft-order { display: flex; flex-direction: column; gap: .1rem; min-height: 0; }
+.draft-order { display: flex; flex-direction: column; gap: .1rem; min-height: 0; overflow: auto; }
 .dorder {
