+  const h = run([{ chessId: id, row: 10, col: 4, skillIndex: 0 }], { defs: { chess: { [id]: raw }, enemies: { kazdelDummy: dummy } } });
+  h.step(); const u = h.unit(id); u.skill.sp = 0;
