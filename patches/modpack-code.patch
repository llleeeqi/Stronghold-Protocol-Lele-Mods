+      const normal = preview(id, 'normal', entries);
+      assert.equal(normal.lo.module, null, `${key}: no module in normal variant`);
+      assert.deepEqual(normal.record.stats, base.stats, `${key}: normal stats untouched`);
+    }
+    assert.equal(JSON.stringify([base, golden]), before, `${key}: preview never mutates data`);
+  }
+});
