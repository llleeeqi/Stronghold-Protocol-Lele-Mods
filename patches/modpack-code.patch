+// Preparation-side Rhine Lab research. Battle device effects live in rhine.js.
+import { RHINE_BOND } from '../../../shared/rhineResearch.js';
+
+export function registerMeta(registry) {
+  registry.garrison('RHINE_RESEARCH_BY_MEMBER', {
+    run(ctx) {
