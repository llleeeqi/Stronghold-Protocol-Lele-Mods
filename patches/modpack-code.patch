+      row.total += owner.total;
+      row.otherDamage += owner.otherDamage;
+      for (const op of owner.operators) {
+        const existing = row.operators.get(op.key);
+        if (existing) existing.damage += op.damage;
+        else row.operators.set(op.key, { ...op });
+      }
+    }
