+for (const skillIndex of [0, 1, 2]) test(`Dorothy S${skillIndex + 1}: native damage/status, Dreamer timing, and one research gain for multi-hit trap`, () => {
+  const h = run('dorothy', { bonds: { rhineShip: { ...active } },
