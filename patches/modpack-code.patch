+    const e = h.spawn('kaz_enemy', { pos: [10, 5] });
+    const hp = [own.hp, other.hp, e.hp], ps = h.b.getPlayer('p1');
+    const state = { ps, stage, cannon: cannonSource(ps, stage), charge: 15, lastFireAt: -Infinity,
+      warning: { x: 5, y: 10, startedAt: -3, until: 0 } };
+    tickCannon(h.b, state, 0, 11, () => {});
+    assert.equal(hp[0] - own.hp, 965);
+    assert.equal(other.hp, hp[1]);
+    assert.equal(hp[2] - e.hp, 965);
+    assert.equal(state.charge, 0);
+    assert.ok(checkInvariants(h.b));
+  });
+}
+
+test('cannon owner survives immediate and delayed derivatives, from copies, nested cannons, buffs and projectiles', () => {
+  const players = ['p1', 'p2'].map((playerId, seat) => ({ playerId, seat, coords: 'field',
+    units: [entry(seat ? 'plain2' : 'plain', 10, 5 + seat)], bonds: { [K]: bond(6) } }));
+  const h = fixture(['plain', 'plain2'], { players, kind: 'unite' });
+  const a = h.unit('kaz_plain'), b = h.unit('kaz_plain2');
+  for (const u of [a, b]) u.profile.noAttack = true;
+  const e = h.spawn('kaz_enemy', { pos: [10, 5] });
+  const ca = cannonSource(h.b.getPlayer('p1'), 2), cb = cannonSource(h.b.getPlayer('p2'), 2);
+  let saved;
+  h.b.on('damaged', c => {
+    if (c.target !== e || c.source !== ca) return;
+    saved = c.dmg;
+    h.b.dealDamage(cb, a, { amount: 100, type: 'true' }); // nested other owner's cannon
+    h.b.dealDamage(e, b, { amount: 100, type: 'true' });
+    h.b.loseHp(b, 100, { source: a });
+    h.b.kill(b, e);
+    h.b.dealDamage(e, a, { amount: 10, type: 'true' }); // original owner restored
+    h.b.after(.1, () => { h.b.loseHp(a, 10); h.b.loseHp(b, 100); h.b.kill(b); });
+    const timer = h.b.every(.1, () => { h.b.loseHp(b, 100); timer.cancel(); });
+    h.b.addProjectile({ from: e, to: { x: b.x, y: b.y }, speed: 10, onHit: () => h.b.loseHp(b, 100) });
+    h.b.addBuff(b, { key: 'owner-test', duration: .2, onTick: () => h.b.loseHp(b, 100), onExpire: () => h.b.kill(b) });
+  });
+  const hp = [a.hp, b.hp];
+  h.b.dealDamage(ca, e, { amount: 10, type: 'true' });
+  assert.equal(saved.kazdelCannonOwnerId, 'p1');
+  h.b.loseHp(a, 10, { source: b, from: saved });
+  h.b.loseHp(b, 100, { source: a, from: saved });
+  h.b.dealDamage(e, b, { ...saved, amount: 100 });
+  h.run(.5);
+  assert.equal(a.hp, hp[0] - 30);
+  assert.equal(b.hp, hp[1]); assert.ok(b.alive);
+  assert.equal(h.b._kazdelCannonDamageDepth, 0);
+  assert.equal(h.b._kazdelCannonOwnerId, undefined);
+  h.b.loseHp(b, 10); assert.equal(b.hp, hp[1] - 10, 'ordinary damage is not protected');
+  assert.equal(h.b.dealDamage(null, b, { amount: 100, type: 'true', tags: ['kazdelCannon'] }), 0, 'missing owner fails closed');
+  assert.ok(checkInvariants(h.b));
+});
+
+test('a real cannon-killed polluted enemy damages only the cannon owner through its delayed death zone', () => {
+  const players = ['p1', 'p2'].map((playerId, seat) => ({ playerId, seat, coords: 'field',
+    units: [entry(seat ? 'plain2' : 'plain', 10, 5 + seat)], bonds: { [K]: bond(6) } }));
+  const h = fixture(['plain', 'plain2'], { players });
+  for (const u of h.b.allyUnits) u.profile.noAttack = true;
+  const [a, b] = h.b.allyUnits, hp = [a.hp, b.hp];
+  const e = h.spawn('enemy_1267_nhpbr', { pos: [10, 5] });
+  die(h, e, cannonSource(h.b.getPlayer('p1'), 2));
+  h.run(2.2);
+  assert.equal(a.hp, hp[0] - 100);
+  assert.equal(b.hp, hp[1]);
+  assert.equal(layers(h), 0); assert.equal(layers(h, K, 'p2'), 0);
+  assert.ok(checkInvariants(h.b));
+});
+
+test('direct-kill death records retain owner at six and nine members when reused outside the cannon stack', () => {
+  for (const count of [6, 9]) {
+  const stage = 2;
+    const h = fixture(['plain'], { count }), a = h.unit('kaz_plain');
+    const e = h.spawn('kaz_enemy', { pos: [10, 5] }); let saved;
+    h.b.on('death', c => { if (c.unit === e) saved = c.dmg; });
+    h.b.kill(e, cannonSource(h.b.getPlayer('p1'), stage));
+    assert.equal(saved.kazdelCannonOwnerId, 'p1');
+    const hp = a.hp;
+    h.b.loseHp(a, 100, { from: saved });
+    assert.equal(hp - a.hp, 100);
+  }
+});
diff --git a/test/content/kazdel_equipment.test.js b/test/content/kazdel_equipment.test.js
new file mode 100644
index 0000000..9840c4b
--- /dev/null
+++ b/test/content/kazdel_equipment.test.js
@@ -0,0 +1,118 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeBattle, chessRec, enemyRec, checkInvariants } from '../helpers/battleHarness.js';
+import { installItem, lendItemEffects, itemGrants } from '../../server/sim/content/items/battle.js';
+import { soulBaseline, createSoul } from '../../server/sim/content/kazdel/souls.js';
+import { cannonSource } from '../../server/sim/content/kazdel/cannon.js';
+import { unitBonds } from '../../server/sim/content/support/index.js';
+
+const K = 'kazdelShip', sigil = (q = 'a') => `chess_item_kazdel_sigil_${q}`, blade = (q = 'a') => `chess_item_kazdel_blade_${q}`;
+const close = (a, b) => assert.ok(Math.abs(a - b) < 1e-6, `${a} != ${b}`);
+function fight(items, { members = true, active = true, layers = 0 } = {}) {
+  const chess = {}, kits = {};
+  for (const id of ['a', 'b', 'c']) {
+    chess[id] = chessRec({ id, bonds: Array.isArray(members) ? members : members ? [K] : [], skill: null,
+      stats: { maxHp: 4000, atk: 1000, def: 0, res: 0, blockCnt: 0, respawnTime: 1000 } });
+    kits[id] = () => ({ trait: { noAttack: true }, skill: null });
+  }
+  const players = ['p1', 'p2'].map((playerId, seat) => ({ playerId, seat, coords: 'field',
+    units: (seat ? ['c'] : ['a', 'b']).map((id, i) => ({ chessId: id, uid: id, row: 10 + seat, col: 4 + i, items: items[id] ?? [] })),
+    bonds: { [K]: { active, count: 6, tier: 2, layers } } }));
+  const h = makeBattle({ players, defs: { chess, enemies: { dummy: enemyRec({ key: 'dummy', hp: 1e8, atk: 0, def: 0, res: 0, speed: 0 }) } },
+    kits, autoFinish: false, timeLimit: 100 });
+  h.step();
+  h.foe = h.spawn('dummy', { pos: [10, 8] });
+  return h;
+}
+function fall(h, id) { const u = h.unit(id); h.b.kill(u); const s = u.kazdelSoulUnit; if (s) s.profile.noAttack = true; return s; }
+function hit(h, source, target = h.foe) { return h.b.dealDamage(source, target, { amount: 100, type: 'true', canDodge: false }); }
+function valid(h) { assert.deepEqual(h.b.errors, []); checkInvariants(h.b); }
+
+test('Kazdel equipment stats are universal, additive, and do not deal damage or add defensive buffs', () => {
+  for (const [items, hp, atk] of [[[sigil()], 3400, 1250], [[sigil('b')], 3200, 1400],
+    [[blade()], 3200, 1400], [[blade('b')], 3000, 1600], [[sigil(), blade()], 2600, 1650],
+    [[sigil('b'), blade('b')], 2200, 2000], [[sigil(), sigil('b')], 2600, 1650]]) {
+    const h = fight({ a: items }, { members: false, active: false }), u = h.unit('a');
+    close(u.s.maxHp, hp); close(u.hp, hp); close(u.s.atk, atk);
+    close(u.s.shield, 0); close(u.s.dmgTakenMul, 1); close(u.s.dmgDealtMul, 1);
+    assert.equal(h.b.getPlayer('p1').bonds[K].layers, 0); assert.ok(u.alive); valid(h);
+  }
+});
+
+test('Blade uses only its corresponding soul, enemy target and same-carrier pairing; gold replaces no extra multiplier', () => {
+  for (const q of ['a', 'b']) for (const sq of ['a', 'b']) {
+    const h = fight({ a: [blade(q)], b: [sigil(sq)], c: [blade(q), sigil(sq)] });
+    close(hit(h, h.unit('a')), 100, 'body is not empowered');
+    const a = fall(h, 'a'), b = fall(h, 'b'), c = fall(h, 'c');
+    close(hit(h, a), 120); close(hit(h, b), 100); close(hit(h, c), 135);
+    close(hit(h, a, b), 100, 'friendly targets are not empowered');
+    close(hit(h, cannonSource(h.b.getPlayer('p1'))), 100);
+    const grant = installItem(h.b, h.unit('a'), sigil(sq), { lent: true });
+    close(hit(h, a), 135); grant.dispose(); close(hit(h, a), 120);
+    h.b.getPlayer('p1').bonds[K].active = false; close(hit(h, a), 100); close(hit(h, c), 135);
+    valid(h);
+  }
+});
+
+test('Blade requires carrier membership, including active Harmony, and never empowers arbitrary summons', () => {
+  const foreign = fight({ a: [blade(), sigil()] }, { members: false });
+  const foreignSoul = createSoul(foreign.b, foreign.unit('a'), 0, () => null);
+  close(hit(foreign, foreignSoul), 100); valid(foreign);
+  const h = fight({ a: [blade(), sigil()] }, { members: ['maniShip'] });
+  h.b.getPlayer('p1').bonds.maniShip = { active: true, count: 2 };
+  const a = fall(h, 'a');
+  close(hit(h, a), 135);
+  h.b.getPlayer('p1').bonds.maniShip.active = false; close(hit(h, a), 100);
+  a.kazdelSoul = false; close(hit(h, a), 100); a.kazdelSoul = true;
+  valid(h);
+});
+
+test('Normal plus elite blades stack ordinary stats but exclusive damage applies once; refresh never compounds', () => {
+  const h = fight({ a: [blade(), blade('b')] }, { layers: 100 }), u = h.unit('a');
+  close(u.s.maxHp, 3200); close(u.s.atk, 2000);
+  const s = fall(h, 'a'); close(s.s.maxHp, 2320); close(s.s.atk, 1900); close(hit(h, s), 120);
+  h.step(60); close(s.s.maxHp, 2320); close(s.s.atk, 1900); close(hit(h, s), 120);
+  assert.equal(s.items.length, 0); close(s.s.dmgDealtMul, 1); valid(h);
+});
+
+test('Borrowed sigil refreshes without stacking, expires on dead donor baseline and cannot lend tier-six blade by default', () => {
+  const h = fight({ a: [blade()], b: [sigil('b'), blade('b')] }, { layers: 100 });
+  const a = h.unit('a'), b = h.unit('b');
+  assert.equal(lendItemEffects(h.b, b, a, { duration: .3 }), 1);
+  assert.equal(lendItemEffects(h.b, b, a, { duration: .3 }), 1);
+  assert.equal(itemGrants(h.b, a).filter(g => g.lent).length, 1);
+  close(a.s.maxHp, 3400); close(a.s.atk, 1800);
+  const s = fall(h, 'a'); close(s.s.maxHp, 2440); close(s.s.atk, 1740); close(hit(h, s), 135);
+  h.run(.5); close(soulBaseline(a).maxHp, 3200); close(s.s.maxHp, 2920); close(s.s.atk, 1420); close(hit(h, s), 120);
+  assert.equal(itemGrants(h.b, a).filter(g => g.lent).length, 0); valid(h);
+});
+
+test('Equipment cannot turn cannon kills into layers/charge and souls retain cannon immunity', () => {
+  const h = fight({ a: [blade(), sigil()], c: [blade(), sigil()] });
+  const a = h.unit('a'), c = h.unit('c'), before = h.b.snapshot().kazdel.map(s => s.charge);
+  const source = cannonSource(h.b.getPlayer('p1'));
+  h.b.dealDamage(source, a, { amount: 1e6, type: 'true' });
+  assert.ok(a.kazdelSoulUnit?.alive); assert.equal(h.b.getPlayer('p1').bonds[K].layers, 0);
+  assert.deepEqual(h.b.snapshot().kazdel.map(s => s.charge), before);
+  assert.equal(h.b.dealDamage(source, a.kazdelSoulUnit, { amount: 1e6, type: 'true' }), 0);
+  assert.equal(h.b.dealDamage(source, c, { amount: 1e6, type: 'true' }), 0); valid(h);
+});
+
+test('Sigil/isomorph membership generates souls and qualifies blade; borrowed sigil never grants a tag', () => {
+  for (const q of ['a', 'b']) for (const iq of ['a', 'b']) {
+    const iso = `chess_item_6_09_e_${iq}`;
+    const h = fight({ a: [sigil(q), iso], b: [sigil(q)], c: [iso] }, { members: false, layers: 100 });
+    const a = h.unit('a'), c = h.unit('c');
+    assert.deepEqual(unitBonds(a), [K]); assert.deepEqual(unitBonds(c), []);
+    const spirit = fall(h, 'a'); assert.ok(spirit);
+    close(spirit.s.maxHp, q === 'a' ? 3040 : 2920); close(spirit.s.atk, q === 'a' ? 1300 : 1420);
+    // Tier VI is not normally lendable; explicitly exercise the existing grant lifecycle.
+    const grant = installItem(h.b, a, blade(), { lent: true }); close(hit(h, spirit), 135);
+    grant.dispose(); close(hit(h, spirit), 100);
+    assert.equal(lendItemEffects(h.b, h.unit('b'), c, { duration: .2 }), 1);
+    assert.deepEqual(unitBonds(c), []); h.run(.3); assert.deepEqual(unitBonds(c), []);
+    a.items = [iso]; assert.deepEqual(unitBonds(a), []);
+    a.items = [sigil(q), iso]; assert.deepEqual(unitBonds(a), [K]);
+    valid(h);
+  }
+});
diff --git a/test/content/kazdel_kits.test.js b/test/content/kazdel_kits.test.js
new file mode 100644
index 0000000..5a510c1
--- /dev/null
+++ b/test/content/kazdel_kits.test.js
@@ -0,0 +1,157 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeBattle, enemyRec, chessRec, checkInvariants } from '../helpers/battleHarness.js';
+import { getDefaultSource } from '../../server/sim/simdata.js';
+import kits from '../../server/sim/content/kits/kazdel.js';
+import { skillSpecSource } from '../../server/sim/content/index.js';
+
+const ds = getDefaultSource();
+const names = ['odd', 'meteorite', 'paprika', 'hoederer', 'logos', 'wisdel'];
+const idOf = (key, elite = false) => `chess_kazdel_${key}_${elite ? 'b' : 'a'}`;
+const dummy = enemyRec({ key: 'kazdelDummy', hp: 1e8, def: 0, res: 0, speed: 0 });
+const run = (units, extra = {}) => makeBattle({ units, kits, defs: { enemies: { kazdelDummy: dummy } }, autoFinish: false, hooks: ['damaged', 'heal', 'skillStart'], captureNoisy: true, ...extra });
+const done = h => { checkInvariants(h.b); assert.deepEqual(h.b.errors, []); };
+
+test('Wisdel gains half cannon damage as on-field base ATK, scaled by skills, refreshed with layers and cleared on leaving', () => {
+  for(const elite of [false,true]) {
+    const id=idOf('wisdel',elite),h=run([{chessId:id,row:10,col:4,skillIndex:1}],{
+      bonds:{kazdelShip:{active:true,count:6,tier:2,layers:10}},
+    });
+    h.step();const u=h.unit(id),e=h.spawn('kazdelDummy',{pos:[10,8]});
+    u.profile.noAttack=true;
+    const base=u.base.atk,skillPct=u.skill.bb.atk;
+    assert.equal(u.s.atk,base+475);
+    u.skill.gainSp(999,'test');assert.ok(u.skill.activate('test'));
+    assert.ok(Math.abs(u.s.atk-(base+475)*(1+skillPct))<1e-6);
+    h.b.getPlayer('p1').bonds.kazdelShip.layers=30;h.step();
+    assert.ok(Math.abs(u.s.atk-(base+625)*(1+skillPct))<1e-6);
+    assert.equal(h.b.dealDamage(u,e,{amount:200,type:'true',isSkill:true}),200,'no separate flat damage bonus');
+    const shadow=h.b.allyUnits.find(v=>v.ownerUnit===u&&v.kind==='token');
+    assert.ok(shadow);assert.equal(h.b.dealDamage(shadow,e,{amount:200,type:'true',isSkill:true}),200);
+    assert.equal(shadow.findBuff('kazdel:wisdelAttack'),null);
+    u.skill.end('test');assert.equal(u.s.atk,base+625,'ordinary attacks keep the base ATK bonus');
+    h.b.retreat(u);assert.equal(u.s.atk,base);assert.equal(u.findBuff('kazdel:wisdelAttack'),null);
+    assert.ok(h.b.redeploy(u,{free:true}));assert.equal(u.s.atk,base+625,'redeploy restores the current bonus immediately');
+    u.hidden=true;h.step();assert.equal(u.s.atk,base);
+    u.hidden=false;h.step();assert.equal(u.s.atk,base+625);
+    h.b.kill(u);const soul=u.kazdelSoulUnit;
+    assert.ok(soul);assert.equal(u.s.atk,base);
+    assert.ok(Math.abs(soul.s.atk-(base*.8+30*3))<1e-6,'souls exclude the body-only ATK bonus');
+    assert.equal(h.b.dealDamage(soul,e,{amount:200,type:'true'}),elite?280:240);
+    done(h);
+  }
+});
+
+test('Wisdel on-field ATK scales native S1/S2/S3 projectiles, splash, aftershocks, explosions and ordinary attacks', () => {
+  for(const elite of [false,true])for(const skillIndex of [0,1,2]) {
+    const fields=[false,true].map(withTrait=>{
+      const id=idOf('wisdel',elite),raw=structuredClone(ds.rawChess(id));
+      if(!withTrait)raw.garrisonIds=[];
+      const h=run([{chessId:id,row:10,col:4,skillIndex}],{
+        seed:17,defs:{chess:{[id]:raw},enemies:{kazdelDummy:dummy}},
+        bonds:{kazdelShip:{active:true,count:6,tier:2,layers:20}},
+      });
+      h.step();const u=h.unit(id),main=h.spawn('kazdelDummy',{pos:[10,5]});
+      h.spawn('kazdelDummy',{pos:[10,5.3]});
+      const hits=[];
+      h.b.on('damaged',c=>{
+        if(c.source===u)hits.push({amount:c.amount,isSkill:c.dmg.isSkill,active:u.skill.active,tags:[...c.dmg.tags]});
+      });
+      u.skill.gainSp(999,'test');assert.ok(u.skill.activate('test'));
+      if(skillIndex===2)u.skill.ammoLeft=1;
+      assert.ok(h.b.forceAttack(u,[main]));u.profile.noAttack=true;
+      if(skillIndex!==1)assert.equal(u.skill.active,false,'the skill ends before its projectile lands');
+      h.run(1.5);
+      if(u.skill.active)u.skill.end('test');
+      const skillHits=hits.splice(0);
+      assert.ok(h.b.forceAttack(u,[main]));h.run(.8);
+      done(h);return {skillHits,ordinaryHits:hits,baseAtk:u.base.atk};
+    });
+    const [plain,boosted]=fields,label=`${elite?'elite':'normal'} S${skillIndex+1}`;
+    assert.equal(boosted.skillHits.length,plain.skillHits.length,label);
+    assert.ok(plain.skillHits.some(c=>c.isSkill&&!c.tags.includes('aftershock')),`${label}: skill projectile`);
+    assert.ok(plain.skillHits.some(c=>c.isSkill&&c.tags.includes('aftershock')),`${label}: skill aftershock`);
+    const ratio=(plain.baseAtk+550)/plain.baseAtk;
+    for(const key of ['skillHits','ordinaryHits']) {
+      assert.equal(boosted[key].length,plain[key].length,`${label}: ${key}`);
+      assert.ok(plain[key].length>0,`${label}: ${key}`);
+      for(const [i,c]of plain[key].entries()) {
+        const expected=c.amount*ratio;
+        assert.ok(Math.abs(boosted[key][i].amount-expected)<1e-6,`${label}: ${key} ${JSON.stringify(c)} => ${boosted[key][i].amount}, expected ${expected}`);
+      }
+    }
+  }
+});
+
+test('Kazdel preset native kits author every skill and selectable ordinary module in both forms', () => {
+  for (const key of names) for (const elite of [false, true]) {
+    const id = idOf(key, elite), raw = ds.rawChess(id);
+    assert.ok(raw.skills.length >= 2, id);
+    for (const sk of raw.skills) for (const moduleId of ['none', ...(raw.modules ?? []).map(m => m.uniEquipId)]) {
+      const def = ds.getChess(id, { skillIndex: sk.index, moduleId });
+      assert.equal(skillSpecSource(def, kits), 'skills', `${id}: ${sk.skillId}`);
+      const h = run([{ chessId: id, row: 10, col: 4, skillIndex: sk.index, moduleId }]);
+      h.step();
+      const u = h.unit(id);
+      assert.equal(u.skill.id, sk.skillId);
+      assert.equal(u.kit.skillSource, 'skills');
+      done(h);
+    }
+  }
+});
+
+test('Odda S2 lifts only secondary splash victims whose mass is at most 3', () => {
+  const id = idOf('odd'), h = run([{ chessId: id, row: 10, col: 4, skillIndex: 1 }]);
+  const u = h.unit(id); h.step();
+  const primary = h.spawn('kazdelDummy', { pos: [10, 5] });
+  const light = h.spawn('kazdelDummy', { pos: [10, 5.4] });
+  const heavy = h.spawn('kazdelDummy', { pos: [10, 5.5] });
+  heavy.base.massLevel = 4; heavy.markDirty();
+  u.skill.gainSp(999, 'test'); u.skill.activate('test');
+  h.b.forceAttack(u, [primary]);
+  assert.equal(!!primary.findBuff('levitate'), false);
+  assert.ok(light.findBuff('levitate'));
+  assert.equal(!!heavy.findBuff('levitate'), false);
+  done(h);
+});
+
+test('Meteorite S2 debuffs every enemy in the shell area and deals physical damage', () => {
+  const id = idOf('meteorite'), h = run([{ chessId: id, row: 10, col: 4, skillIndex: 1 }]);
+  const u = h.unit(id); h.step();
+  const e = h.spawn('kazdelDummy', { pos: [10, 5] });
+  h.step();
+  u.skill.gainSp(999, 'test'); assert.ok(u.skill.activate('test'));
+  assert.ok(e.findBuff('meteo:def'));
+  assert.ok(e.hp < e.s.maxHp);
+  assert.ok(h.hooksOf('damaged').some(c => c.source === u && c.dmg.tags.includes('meteo:shell')));
+  done(h);
+});
+
+test('Meteorite critical shell retains its bonus across projectile flight and splash victims', () => {
