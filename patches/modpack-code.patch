+  for (const key of u.rangeKeys) { const r = Math.floor(key / 21), c = key % 21; if (!traps(h).some(t => t.tileR === r && t.tileC === c)) h.spawn('e', { pos: [r, c] }); }
+  cast(u); assert.equal(traps(h).length, 2); valid(h);
