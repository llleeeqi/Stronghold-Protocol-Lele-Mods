+    fx.simFx('kazdelSoulHeal',5,10,{source:1,target:2});assert.equal(beams.length,1);
+    fx.simFx('kazdelSoulEnd',5,10,{id:2,soulOf:1,reason:'kazdelReturn'});assert.equal(beams.length,2);
+  }
+});
