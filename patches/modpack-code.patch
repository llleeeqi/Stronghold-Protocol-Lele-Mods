+const ids=['chess_char_6_aglna2_a','chess_char_6_oblvns_a'];
+const clean=h=>{assert.deepEqual(h.b.errors,[]);checkInvariants(h.b);};
+function setup(id,index=2,gold=false,fly=false){
+ const cid=gold?id.replace(/_a$/,'_b'):id;
