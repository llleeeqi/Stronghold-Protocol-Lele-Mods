+   if(Math.hypot(v.x-e.x-f*dx,v.y-e.y-f*dy)<=(bb['attack@projectile_range']??1)/2)
+    b.dealDamage(u,v,{amount:u.s.atk*(bb['attack@atk_scale_comeback']??1),type:'phys',isSkill:true,isAttack:true,tags:['narantReturnPath']});
+  }
