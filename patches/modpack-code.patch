+      const meta = ownerMeta(owner);
+      if (typeof meta.playerId === 'string' && !this.owners.has(meta.playerId)) this.owners.set(meta.playerId, meta);
+    }
+    this.round = round;
+    this.phase = phase;
+    this.status = 'live';
+    this._frozen = null;
+    return true;
+  }
+
+  /**
